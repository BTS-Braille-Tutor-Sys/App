<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="카테고리: 약자"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/charText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="가"
            android:textColor="#000000"
            android:textSize="100sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <GridLayout
                android:id="@+id/brailleLayout1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:padding="10dp">

                <ImageView android:id="@+id/dot1" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot4" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot2" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot5" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot3" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot6" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
            </GridLayout>

            <GridLayout
                android:id="@+id/brailleLayout2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3"
                android:padding="10dp"
                android:layout_marginStart="20dp">

                <ImageView android:id="@+id/dot7" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot10" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot8" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot11" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot9" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
                <ImageView android:id="@+id/dot12" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/dot_inactive" android:layout_margin="5dp"/>
            </GridLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/prevCharBtn"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="이전 글자 보기"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#757575"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/nextCharBtn"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="다음 글자 보기"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

    <include
        layout="@layout/layout_exit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp" />

</FrameLayout>